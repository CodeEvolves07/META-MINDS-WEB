PORT=5001

# Judge0 CE Configuration (Optional)
# If left empty, CodeMeet's built-in sandbox engine executes code cleanly for instant hackathon demos
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# WebRTC STUN & TURN Configuration (for cross-network / different Wi-Fi support)
# Multiple Google STUN servers are enabled by default (stun.l.google.com:19302).
# For strict symmetric NATs / mobile hotspots, specify your TURN server credentials below:
# Example:
# TURN_URLS=turn:your-turn-server.com:3478?transport=udp,turn:your-turn-server.com:3478?transport=tcp
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_password
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

